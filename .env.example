# Copy to .env and edit. run.sh reads these; .env is gitignored.

# Folder to serve (read-only)
PEEKADOC_ROOT=$HOME/Documents

# Listen address. Leave unset to auto-detect the Tailscale IP.
# PEEKADOC_ADDR=100.101.102.103:8000

# Port used with the auto-detected address
PEEKADOC_PORT=8000

# Optional: override the generated password or Tailscale full DNS name.
# PEEKADOC_PASSWORD=choose-a-strong-password
# PEEKADOC_TLS_NAME=machine-name.tailnet.ts.net

# Extra peekadoc flags
# PEEKADOC_ARGS="-no-download"
